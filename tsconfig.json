{
    "compilerOptions": {
        "lib": [
            "ESNext"
        ],
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "strict": true,
        "esModuleInterop": true,
        "allowImportingTsExtensions": true,
        "strictPropertyInitialization": false,
        "forceConsistentCasingInFileNames": true,
        "types": ["bun"],
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules/**"
    ]
}